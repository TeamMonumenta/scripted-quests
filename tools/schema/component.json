		"italic": {
			"propertyOrder": 4,
			"title": "italic",
			"type": "boolean",
			"format": "checkbox"
		},
		"underlined": {
			"propertyOrder": 5,
			"title": "underlined",
			"type": "boolean",
			"format": "checkbox"
		},
		"strikethrough": {
